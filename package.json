{
  "name": "lmstudio-companion",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "diagnose": "node dist/host/src/diagnose.js",
    "start": "node dist/host/src/main.js",
    "test:panel": "node scripts/check-panel.mjs",
    "test:memory-panel": "node scripts/check-memory-panel.mjs",
    "package": "node scripts/package.mjs",
    "test:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@lmstudio/sdk": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "3.2.7"
  }
}

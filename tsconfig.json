{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/core/src/**/*.ts", "packages/host/src/**/*.ts", "packages/lmstudio-plugin/src/**/*.ts", "tests/foundation/**/*.ts", "vitest.config.ts"]
}
